{
  "$comment": "The Open Waters event contract: the only hand-written definition. src/generated/contract.ts and docs/events.md are generated from it by `pnpm run generate`. Every item carries `since`, the taxonomy version that added it; a version's list is everything with `since` at or below it. Add, never rename or remove. See AGENTS.md.",
  "versions": [
    {
      "version": 1,
      "date": "2026-09-17",
      "change": "First version"
    },
    {
      "version": 2,
      "date": "2026-09-22",
      "change": "Added `consent_updated` and the `ad_consent` super property, for sites with paid advertising. Nothing renamed or removed: a v1 site that moves to v2 without a banner changes only its `taxonomy_version` and starts sending `ad_consent: \"unset\"`"
    },
    {
      "version": 3,
      "date": "2026-09-24",
      "change": "Added `channel`, `utm_source`, `utm_medium`, `utm_campaign`, `referring_domain` and `heard_about` to `lead_submitted`, and `channel` to `lead_qualified` and `deal_won`, so the server-side lead count splits by where visitors came from. All optional: the server capture sends `channel: \"unknown\"` on a lead that has none. Nothing renamed or removed"
    }
  ],
  "superProperties": [
    {
      "name": "site",
      "since": 1,
      "type": "string",
      "origin": "both",
      "example": "`radara`",
      "doc": "The client slug. Matches the internal app's client registry"
    },
    {
      "name": "taxonomy_version",
      "since": 1,
      "type": "string",
      "origin": "both",
      "example": "`\"{version}\"`",
      "doc": "The version at the top of this file"
    },
    {
      "name": "page_type",
      "since": 1,
      "type": "string",
      "origin": "browser",
      "example": "`service`",
      "doc": "From the element carrying `data-page-type`: `<body>` on Astro, `<main>` on Next.js. One of the page types below. Browser only"
    },
    {
      "name": "ad_consent",
      "since": 2,
      "type": {
        "enum": ["granted", "denied", "unset"]
      },
      "origin": "browser",
      "example": "`unset`",
      "doc": "`granted`, `denied` or `unset`: the visitor's current \"Advertising\" choice. Always `unset` on a site with no consent banner. Browser only. See the skill's `references/advertising.md`, \"Reporting\""
    }
  ],
  "pageTypes": {
    "doc": "Add a new type here before using it on a site. These are what let the report compare \"service pages\" across clients whose URLs have nothing in common.",
